{
  "schema_version": 1,
  "id": "deepseek-v4-pro",
  "name": "DeepSeek-V4-Pro",
  "provider": "DeepSeek",
  "organization": "DeepSeek",
  "protocol": "openai_compatible",
  "deployment_kind": "api",
  "model_id": "deepseek-v4-pro",
  "model_id_editable": false,
  "default_base_url": "https://api.deepseek.com",
  "base_url_editable": false,
  "auth_modes": ["env"],
  "default_api_key_env": "DEEPSEEK_API_KEY",
  "trust_env": true,
  "shared": false,
  "request_limits": {"max_concurrency": 4, "min_interval_s": 0.0, "scope": "process"},
  "model_info": {"context_window": 1000000, "max_output_tokens": 384000},
  "capabilities": {
    "text_generation": true,
    "tool_calls": true,
    "json_output": true,
    "reasoning_content": true,
    "thinking_toggle": true,
    "preserve_thinking": false,
    "native_thinking_budget": false,
    "reasoning_effort_values": ["high", "max"]
  },
  "thinking_protocol": "deepseek",
  "notes": "Official DeepSeek OpenAI-compatible API. Thinking is enabled by default; V4 uses reasoning_effort high/max rather than a token thinking budget."
}

{
  "schema_version": 14,
  "id": "gaia-independent",
  "metadata": {
    "name": "gaia-independent",
    "description": "Controlled generalist tool-using single-agent GAIA anchor.",
    "tags": [],
    "provenance": {
      "track": "controlled_portability",
      "evidence_level": "paper_inspired",
      "sources": [
        {
          "title": "GAIA",
          "url": "https://arxiv.org/abs/2311.12983",
          "scope": "benchmark task and scoring protocol"
        },
        {
          "title": "Coding Agents with Multimodal Browsing are Generalist Problem Solvers",
          "url": "https://openreview.net/forum?id=6HF55i7bca",
          "scope": "generalist single-agent evidence"
        }
      ],
      "notes": "This is not the official GAIA baseline or a reproduction of a named scaffold."
    }
  },
  "nodes": [
    {
      "id": "Generalist",
      "name": "Generalist",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Single generalist with the case-local GAIA sandbox.",
      "instructions": "Solve the GAIA task independently. Use list_workspace/read_text_file for attachments and CodeExecutor for Python, shell commands through subprocess, document processing, web requests, and calculations. Verify evidence before answering. End with exactly: FINAL ANSWER: <short answer>",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 20
      }
    }
  ],
  "relations": [],
  "shared_state": [
    {
      "id": "TrialWorkspace",
      "kind": "artifact_store",
      "description": "Trial-scoped shared state, files, and structured artifacts.",
      "readers": [
        "Generalist"
      ],
      "writers": [
        "Generalist"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": {},
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    }
  ],
  "lifecycle": {
    "entry": [
      {
        "node": "Generalist",
        "inputs": [
          {
            "source": "trial.task",
            "target": "task",
            "required": true,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    ],
    "result": {
      "submissions": [
        {
          "from": "Generalist",
          "source": "source.output",
          "key": "final_answer"
        }
      ],
      "mode": "first_valid",
      "schema": {}
    },
    "termination": {
      "condition": "result_submitted"
    },
    "failure": {
      "unhandled": "fail_trial",
      "deadlock": "fail_trial"
    },
    "limits": {
      "max_turns": null,
      "max_node_calls": null,
      "max_stalls": null,
      "timeout_seconds": null
    }
  }
}

{
  "schema_version": 14,
  "id": "workbench-sequential",
  "metadata": {
    "name": "workbench-sequential",
    "description": "Controlled plan-execute-audit workplace workflow.",
    "tags": [],
    "provenance": {
      "track": "controlled_portability",
      "evidence_level": "paper_inspired",
      "sources": [
        {
          "title": "WorkBench",
          "url": "https://arxiv.org/abs/2405.00823",
          "scope": "task, tools, and evaluator"
        },
        {
          "title": "EvoMAS",
          "url": "https://arxiv.org/abs/2602.06511",
          "scope": "direct WorkBench evaluation with staged peer-review and other MAS pools"
        },
        {
          "title": "EvoMAS WorkBench peer-review configuration",
          "url": "https://github.com/amazon-science/EvoMAS/blob/93fd9d6766b093f6bbdeeffc35896910cbece6e2/mas_pools/workbench/email/peer_review.yaml",
          "scope": "creator-reviewer-reviser-aggregator workflow"
        }
      ],
      "notes": "This planner-executor-auditor pipeline is a reduced controlled adaptation of staged workplace solve/review. It does not reproduce EvoMAS fan-out, agent count, model palette, or aggregation."
    }
  },
  "nodes": [
    {
      "id": "Planner",
      "name": "Planner",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Plans workplace operations without mutating state.",
      "instructions": "Today's date is Thursday, 2023-11-30. Analyze the workplace request, constraints, and required tool sequence. Give Executor a concise plan. Do not call tools or claim completion.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    },
    {
      "id": "Executor",
      "name": "Executor",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Executes the planned workplace actions.",
      "instructions": "Today's date is Thursday, 2023-11-30 and meetings must stay within 9am-6pm. Execute the request with the registered tools. Inspect every result and report the resulting state. Do not emit TASK COMPLETE.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "benchmark:tools",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 20
      }
    },
    {
      "id": "Auditor",
      "name": "Auditor",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Checks the executed workplace actions without introducing duplicate side effects.",
      "instructions": "Audit Executor's reported tool calls and results against the original request. Do not repeat a mutating action. If the action is correct and side effects are acceptable, reply TASK COMPLETE; otherwise state the exact correction Executor must make.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    }
  ],
  "relations": [
    {
      "id": "relation-1",
      "from": "Executor",
      "to": "Auditor",
      "control": {
        "trigger": "completed",
        "action": "activate",
        "condition": null,
        "priority": 0,
        "on_failure": "fail_trial",
        "max_uses": null
      },
      "data": {
        "transfers": [
          {
            "source": "trial.task",
            "target": "task",
            "required": true,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          },
          {
            "source": "shared.SharedConversation",
            "target": "messages",
            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          },
          {
            "source": "shared.TrialWorkspace",
            "target": "state",
            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    },
    {
      "id": "relation-2",
      "from": "Planner",
      "to": "Executor",
      "control": {
        "trigger": "completed",
        "action": "activate",
        "condition": null,
        "priority": 0,
        "on_failure": "fail_trial",
        "max_uses": null
      },
      "data": {
        "transfers": [
          {
            "source": "trial.task",
            "target": "task",
            "required": true,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          },
          {
            "source": "shared.SharedConversation",
            "target": "messages",
            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          },
          {
            "source": "shared.TrialWorkspace",
            "target": "state",
            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    }
  ],
  "shared_state": [
    {
      "id": "SharedConversation",
      "kind": "message_channel",
      "description": "Trial-scoped shared conversation used by the team.",
      "readers": [
        "Planner",
        "Executor",
        "Auditor"
      ],
      "writers": [
        "Planner",
        "Executor",
        "Auditor"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": [],
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    },
    {
      "id": "TrialWorkspace",
      "kind": "artifact_store",
      "description": "Trial-scoped shared state, files, and structured artifacts.",
      "readers": [
        "Planner",
        "Executor",
        "Auditor"
      ],
      "writers": [
        "Planner",
        "Executor",
        "Auditor"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": {},
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    }
  ],
  "lifecycle": {
    "entry": [
      {
        "node": "Planner",
        "inputs": [
          {
            "source": "trial.task",
            "target": "task",
            "required": true,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    ],
    "result": {
      "submissions": [
        {
          "from": "Auditor",
          "source": "source.output",
          "key": "final_answer"
        }
      ],
      "mode": "first_valid",
      "schema": {}
    },
    "termination": {
      "condition": "result_submitted"
    },
    "failure": {
      "unhandled": "fail_trial",
      "deadlock": "fail_trial"
    },
    "limits": {
      "max_turns": null,
      "max_node_calls": null,
      "max_stalls": null,
      "timeout_seconds": null
    }
  }
}

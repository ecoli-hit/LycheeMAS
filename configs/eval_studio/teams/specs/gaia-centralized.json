{
  "schema_version": 14,
  "id": "gaia-centralized",
  "metadata": {
    "name": "gaia-centralized",
    "description": "Controlled model-routed GAIA team, distinct from Magentic-One.",
    "tags": [],
    "provenance": {
      "track": "controlled_portability",
      "evidence_level": "paper_inspired",
      "sources": [
        {
          "title": "Beyond Rule-Based Workflows",
          "url": "https://arxiv.org/abs/2601.09883",
          "scope": "central information-flow orchestration"
        },
        {
          "title": "COLA",
          "url": "https://arxiv.org/abs/2503.09263",
          "scope": "dynamic capability-based scheduling"
        }
      ],
      "notes": "The portable model-selector contract is a controlled abstraction, not either paper's native implementation."
    }
  },
  "nodes": [
    {
      "id": "Researcher",
      "name": "Researcher",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Searches the web and inspects case-local evidence.",
      "instructions": "Gather reliable evidence from the web and case-local files. Cite the evidence needed by the solver and do not guess.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    },
    {
      "id": "Solver",
      "name": "Solver",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Combines evidence and computes a candidate answer.",
      "instructions": "Solve the task from the available evidence. Use tools for calculations and verification. Keep exact names, dates, units, and formatting.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    },
    {
      "id": "Verifier",
      "name": "Verifier",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Checks evidence and produces the final short answer.",
      "instructions": "Independently check the candidate answer against evidence and the original question. If evidence is incomplete, state the exact missing evidence so Researcher or Solver can continue. When verified, end with exactly: FINAL ANSWER: <short answer>",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    },
    {

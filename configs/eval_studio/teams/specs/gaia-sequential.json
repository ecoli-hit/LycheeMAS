            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          },
          {
            "source": "shared.TrialWorkspace",
            "target": "state",
            "required": false,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    }
  ],
  "shared_state": [
    {
      "id": "SharedConversation",
      "kind": "message_channel",
      "description": "Trial-scoped shared conversation used by the team.",
      "readers": [
        "Researcher",
        "Solver",
        "Verifier"
      ],
      "writers": [
        "Researcher",
        "Solver",
        "Verifier"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": [],
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    },
    {
      "id": "TrialWorkspace",
      "kind": "artifact_store",
      "description": "Trial-scoped shared state, files, and structured artifacts.",
      "readers": [
        "Researcher",
        "Solver",
        "Verifier"
      ],
      "writers": [
        "Researcher",
        "Solver",
        "Verifier"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": {},
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    }
  ],
  "lifecycle": {

{
  "schema_version": 14,
  "id": "gaia-sequential",
  "metadata": {
    "name": "gaia-sequential",
    "description": "Controlled research-solve-verify GAIA workflow.",
    "tags": [],
    "provenance": {
      "track": "controlled_portability",
      "evidence_level": "paper_inspired",
      "sources": [
        {
          "title": "Magentic-One",
          "url": "https://arxiv.org/abs/2411.04468",
          "scope": "specialized tool roles"
        },
        {
          "title": "Beyond Rule-Based Workflows",
          "url": "https://arxiv.org/abs/2601.09883",
          "scope": "controlled GAIA role/orchestration comparison"
        }
      ],
      "notes": "Roles are adapted into a fixed portable workflow; this is not a Magentic-One or CORAL reproduction."
    }
  },
  "nodes": [
    {
      "id": "Researcher",
      "name": "Researcher",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Collects evidence from attachments and the web.",
      "instructions": "Investigate the GAIA task. Use the available workspace and CodeExecutor tools to inspect files, query the web, and gather verifiable evidence. Report findings and sources; do not publish the final answer.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 12
      }
    },
    {
      "id": "Solver",
      "name": "Solver",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Synthesizes evidence and performs computation.",
      "instructions": "Use the original task and collected evidence to derive a precise candidate answer. Use tools for missing calculations or evidence. Do not emit FINAL ANSWER.",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 12
      }
    },
    {
      "id": "Verifier",
      "name": "Verifier",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Checks evidence and produces the short answer.",
      "instructions": "Check the candidate against the original question and available evidence. Use tools when verification is incomplete. End with exactly: FINAL ANSWER: <short answer>",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [
        {
          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 12
      }
    }
  ],
  "relations": [
    {
      "id": "relation-1",
      "from": "Researcher",
      "to": "Solver",
      "control": {
        "trigger": "completed",
        "action": "activate",
        "condition": null,
        "priority": 0,
        "on_failure": "fail_trial",
        "max_uses": null
      },
      "data": {
        "transfers": [
          {
            "source": "trial.task",
            "target": "task",

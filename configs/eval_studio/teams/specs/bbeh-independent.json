{
  "schema_version": 14,
  "id": "bbeh-independent",
  "metadata": {
    "name": "bbeh-independent",
    "description": "Controlled single-agent BBEH anchor; not an official model reproduction.",
    "tags": [],
    "provenance": {
      "track": "controlled_portability",
      "evidence_level": "paper_inspired",
      "sources": [
        {
          "title": "BIG-Bench Extra Hard",
          "url": "https://arxiv.org/abs/2502.19187",
          "scope": "benchmark and single-model evaluation protocol"
        },
        {
          "title": "EvoMAS",
          "url": "https://arxiv.org/abs/2602.06511",
          "scope": "BBEH single CodeAgent baseline and MAS comparison"
        },
        {
          "title": "EvoMAS single BBEH configuration",
          "url": "https://github.com/amazon-science/EvoMAS/blob/93fd9d6766b093f6bbdeeffc35896910cbece6e2/mas_pools/bbeh/single_codeagent.yaml",
          "scope": "executable single-agent reference"
        }
      ],
      "notes": "The matrix key independent intentionally means a one-node single-agent baseline. It is not an Independent multi-agent ensemble."
    }
  },
  "nodes": [
    {
      "id": "Solver",
      "name": "Solver",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Strong single-agent BBEH baseline.",
      "instructions": "Solve the BIG-Bench Extra Hard task independently. Check the reasoning before answering. End with exactly one line: The final answer is: <answer>",
      "capabilities": [
        "reason"
      ],
      "operations": [],
      "tools": [],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 1
      }
    }
  ],
  "relations": [],
  "shared_state": [
    {
      "id": "TrialWorkspace",
      "kind": "artifact_store",
      "description": "Trial-scoped shared state, files, and structured artifacts.",
      "readers": [
        "Solver"
      ],
      "writers": [
        "Solver"
      ],
      "update": "append",
      "lifetime": "trial",
      "initial": {},
      "schema": {},
      "retention": {
        "max_items": null,
        "max_tokens": null,
        "overflow": "drop_oldest"
      }
    }
  ],
  "lifecycle": {
    "entry": [
      {
        "node": "Solver",
        "inputs": [
          {
            "source": "trial.task",
            "target": "task",
            "required": true,
            "view": "all",
            "latest_n": null,
            "filter": null,
            "transform": null,
            "schema": {}
          }
        ]
      }
    ],
    "result": {
      "submissions": [
        {
          "from": "Solver",
          "source": "source.output",
          "key": "final_answer"
        }
      ],
      "mode": "first_valid",
      "schema": {}
    },
    "termination": {
      "condition": "result_submitted"
    },
    "failure": {
      "unhandled": "fail_trial",
      "deadlock": "fail_trial"
    },
    "limits": {
      "max_turns": null,
      "max_node_calls": null,
      "max_stalls": null,
      "timeout_seconds": null
    }
  }
}

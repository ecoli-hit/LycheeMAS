          "id": "list_workspace",
          "required": true
        },
        {
          "id": "read_text_file",
          "required": true
        },
        {
          "id": "runtime:web_search",
          "required": true
        },
        {
          "id": "runtime:fetch_url",
          "required": true
        },
        {
          "id": "runtime:python_code",
          "required": true
        }
      ],
      "context": {
        "type": "token_limited"
      },
      "limits": {
        "max_tool_iterations": 12
      }

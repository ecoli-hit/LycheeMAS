      "name": "Researcher",
      "kind": "model_agent",
      "behavior": {
        "type": "assistant",
        "options": {}
      },
      "purpose": "Independently gathers external and attachment evidence.",
      "instructions": "Independently investigate the GAIA task with the available workspace, browser, and Python tools. Report concrete evidence, source details, and a candidate when possible. Do not publish FINAL ANSWER.",
      "capabilities": [
        "reason",
        "handoff"
      ],
      "operations": [
        {
          "type": "handoff",
          "options": {
            "mode": "model",
            "max_attempts": 1,
            "fallback": "next_priority"
          }
        }
      ],
